{
  "name": "celestea-studio-desktop",
  "version": "2.8.1",
  "exports": "./src/main.ts",
  "nodeModulesDir": "none",
  "lock": false,
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "types": [
      "./src/deno-desktop.d.ts"
    ]
  },
  "desktop": {
    "app": {
      "name": "Celestea Studio",
      "identifier": "com.celestea.studio",
      "icons": {
        "linux": "./icons/icon-512.png",
        "windows": "./icons/icon.ico",
        "macos": "./icons/app.icns"
      }
    },
    "backend": "webview"
  },
  "tasks": {
    "icons": "python3 scripts/gen-icons.py",
    "bundle": "node scripts/bundle-server.mjs",
    "stage": "node scripts/stage.mjs",
    "build": "node scripts/build.mjs",
    "build:linux": "node scripts/build.mjs --target linux",
    "build:deb": "node scripts/build.mjs --target linux --formats AppImage,deb",
    "build:all": "node scripts/build.mjs --all-targets --macos-unsigned",
    "index": "node scripts/build.mjs --index-only",
    "release": "node scripts/make-release.mjs",
    "check": "deno check src/main.ts",
    "dev": "deno run -A src/main.ts --port 3778",
    "self-test": "deno run -A src/main.ts --self-test"
  }
}
