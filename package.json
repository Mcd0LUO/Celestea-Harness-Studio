{
  "name": "celestea-studio-ts",
  "version": "2.8.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Celestea Studio backend - TypeScript rewrite (P0: contract freeze + skeleton + golden-sample toolchain)",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0 <27.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/root.tsbuildinfo",
    "start": "tsx apps/cli/src/main.ts web",
    "stop": "node scripts/studio-stop.mjs",
    "start:studio": "pnpm --dir apps/studio start",
    "desktop:icons": "python3 desktop/scripts/gen-icons.py",
    "desktop:build": "node desktop/scripts/build.mjs",
    "desktop:build:deb": "node desktop/scripts/build.mjs --format deb",
    "desktop:build:all": "node desktop/scripts/build.mjs --all-targets --macos-unsigned",
    "desktop:index": "node desktop/scripts/build.mjs --index-only",
    "desktop:check": "deno check --config desktop/deno.json desktop/src/main.ts",
    "desktop:release": "node desktop/scripts/make-release.mjs",
    "desktop:serve-release": "node desktop/scripts/serve-release.mjs",
    "desktop:repair": "node desktop/scripts/repair-rollback.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx scripts/bench/index.ts",
    "contracts:verify": "tsx scripts/verify-contracts.ts",
    "golden:export": "tsx scripts/export-golden.ts",
    "replay:compare": "tsx scripts/compare-replay.ts",
    "replay:e2e": "tsx scripts/replay-e2e.ts",
    "lint": "eslint .",
    "lint:arch": "depcruise --config .dependency-cruiser.cjs packages apps/studio apps/cli scripts tests",
    "check": "node scripts/check-parallel.mjs",
    "typecheck:web": "pnpm --dir apps/web run typecheck",
    "check:fast": "pnpm typecheck && pnpm typecheck:web && pnpm lint && pnpm lint:arch && pnpm check:tmpdir",
    "check:tmpdir": "node scripts/check-test-tmpdir.mjs",
    "check:web": "pnpm --dir apps/web run build && node scripts/run-with-env.mjs CELESTEA_BUNDLE_STRICT=1 -- pnpm --dir apps/web run check",
    "node:check": "node scripts/check-node.mjs",
    "version:sync": "node scripts/version.mjs --write",
    "deps:audit": "pnpm audit; pnpm outdated -r",
    "build": "pnpm -r --filter \"!celestea-studio-frontend\" build",
    "build:web": "pnpm --dir apps/web run build",
    "release:check": "node scripts/release-check.mjs",
    "release": "pnpm run build && pnpm run release:check",
    "publish": "node scripts/publish.mjs",
    "verify:win": "tsx scripts/verify-windows.ts",
    "check:serial": "pnpm typecheck && pnpm lint && pnpm lint:arch && pnpm check:tmpdir && pnpm test && pnpm check:web",
    "test:changed": "vitest run --changed",
    "test:related": "vitest related",
    "check:sleep": "node scripts/check-sleep-debt.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
